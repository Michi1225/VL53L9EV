{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build.sh",
            "args": [
                "--config",
                "${input:buildConfig}",
                "--target",
                "${input:buildTarget}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "detail": "Build Debug/Release and select Appli, FSBL, ExtMemLoader or all."
        },
        {
            "label": "Internal: Build Appli Debug",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build.sh",
            "args": [
                "--config",
                "Debug",
                "--target",
                "appli",
                "--dev"
            ],
            "problemMatcher": "$gcc",
            "hide": true
        },
        {
            "label": "Internal: Build FSBL Debug",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build.sh",
            "args": [
                "--config",
                "Debug",
                "--target",
                "fsbl"
            ],
            "problemMatcher": "$gcc",
            "hide": true
        },
        {
            "label": "Dev: Load + Run SRAM (detach)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/run_dev.sh",
            "args": [
                "--action",
                "run",
                "--target",
                "${input:devTarget}",
                "--config",
                "${input:devConfig}",
                "--build"
            ],
            "problemMatcher": [],
            "detail": "BOOT1=1: build, load selected ELF into SRAM, run and detach."
        },
        {
            "label": "Flash: Build + Program",
            "type": "process",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                "--target",
                "${input:flashTarget}",
                "--config",
                "${input:flashConfig}",
                "--build"
            ],
            "problemMatcher": [],
            "detail": "Build/sign firmware, program external SEMPER flash and refresh the selected Appli/FSBL build timestamps and device parameters."
        },
        {
            "label": "Flash: Program Existing Images",
            "type": "process",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                "--target",
                "${input:flashTarget}"
            ],
            "problemMatcher": [],
            "detail": "Program existing signed images and refresh selected Appli/FSBL build/flash timestamps, retaining original image build times from verified manifests."
        },
        {
            "label": "Flash: Program Parameters",
            "type": "process",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                "--target",
                "parameters",
                "--parameters",
                "${workspaceFolder}/config/flash_parameters.json"
            ],
            "problemMatcher": [],
            "detail": "Replace editable settings, refresh parameter_build.built_at_utc and repository/flash metadata, and preserve on-board firmware build dates. No local firmware images required."
        },
        {
            "label": "Monitor: Board Viewer",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/test_scripts/Board_Viewer.py"
            ],
            "problemMatcher": [],
            "detail": "Open desktop USB/Ethernet sensor and device-parameter monitor. Requires numpy, matplotlib, pyserial and Tk."
        }
    ],
    "inputs": [
        {
            "id": "buildConfig",
            "type": "pickString",
            "description": "Build configuration",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        },
        {
            "id": "buildTarget",
            "type": "pickString",
            "description": "Build target",
            "options": [
                "appli",
                "fsbl",
                "extmem",
                "all"
            ],
            "default": "all"
        },
        {
            "id": "devConfig",
            "type": "pickString",
            "description": "Development build configuration",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        },
        {
            "id": "devTarget",
            "type": "pickString",
            "description": "SRAM development target",
            "options": [
                "appli",
                "fsbl"
            ],
            "default": "appli"
        },
        {
            "id": "flashConfig",
            "type": "pickString",
            "description": "Configuration to build before programming",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        },
        {
            "id": "flashTarget",
            "type": "pickString",
            "description": "External flash target",
            "options": [
                "all",
                "fsbl",
                "appli-a",
                "appli-b",
                "parameters"
            ],
            "default": "all"
        }
    ]
}
